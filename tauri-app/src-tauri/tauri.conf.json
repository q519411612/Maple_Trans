{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Maple Patch",
  "version": "0.1.0",
  "identifier": "fun.open-maple-patch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Maple Patch",
        "width": 1080,
        "height": 720,
        "minWidth": 840,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
